# QCML-Geometric SDE Data Pipeline Configuration

# ============================================================================
# API Keys (Phase 1 - Required)
# ============================================================================

# Polygon.io API Key (primary data source)
# Get yours at: https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=your_polygon_api_key_here

# Alpaca API Keys (optional fallback)
# Get yours at: https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key


# ============================================================================
# Data Storage Configuration
# ============================================================================

# Base path for data storage
DATA_PATH=./data

# Parquet compression method (snappy, gzip, brotli, none)
PARQUET_COMPRESSION=snappy


# ============================================================================
# Feature Engineering Settings (Phase 2)
# ============================================================================

# Technical indicator windows
TECHNICAL_WINDOW_SHORT=20
TECHNICAL_WINDOW_LONG=200

# Cross-sectional feature windows
CORRELATION_WINDOW=60
RELATIVE_STRENGTH_WINDOW=20

# Sector momentum lookback
SECTOR_MOMENTUM_WINDOW=30


# ============================================================================
# Preprocessing Configuration (Phase 2)
# ============================================================================

# Normalization method (rolling_zscore, cross_sectional_zscore, min_max, robust)
NORMALIZATION_METHOD=rolling_zscore
NORMALIZATION_WINDOW=20

# Missing data handling
MAX_MISSING_GAP_DAYS=3
DROP_SPARSE_THRESHOLD=0.05  # Drop assets with >5% missing data


# ============================================================================
# Universe Settings
# ============================================================================

# Liquidity filters
MIN_VOLUME=1000000  # Minimum average daily volume
MIN_PRICE=5.0       # Minimum price per share
MAX_UNIVERSE_SIZE=500


# ============================================================================
# Walk-Forward Validation (Phase 2)
# ============================================================================

# Train/test split parameters
TRAIN_SIZE_DAYS=252  # ~1 year
TEST_SIZE_DAYS=63    # ~3 months
EMBARGO_DAYS=5       # Gap between train and test


# ============================================================================
# QCML Framework Configuration
# ============================================================================

# Hilbert space dimension for QCML operators
HILBERT_DIM=4

# Regime detector window size
REGIME_WINDOW_SIZE=30

# Chern number computation parameters
BERRY_PHASE_SAMPLES=100


# ============================================================================
# Crisis Analysis Configuration
# ============================================================================

# Historical crisis analysis date ranges
CRISIS_LOOKBACK_MONTHS=6
CRISIS_LOOKAHEAD_MONTHS=6

# Crisis-specific universes (comma-separated symbols)
CRISIS_2008_UNIVERSE=SPY,XLF,BAC,JPM,C,GS,MS,WFC,USB,PNC
CRISIS_2020_UNIVERSE=SPY,QQQ,XLF,XLE,XLK,XLV,XLY,IWM
CRISIS_2022_UNIVERSE=SPY,XLF,XLRE,XLU,TLT,IEF,SHY


# ============================================================================
# Logging Configuration
# ============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./logs/qcml_pipeline.log


# ============================================================================
# Performance Tuning
# ============================================================================

# API rate limiting
API_RATE_LIMIT_DELAY=0.2  # seconds between requests
API_MAX_RETRIES=3
API_TIMEOUT=30

# Parallel processing
N_JOBS=-1  # -1 uses all available cores

# Cache settings
CACHE_DIR=./data/cache
MAX_MEMORY_CACHE_ITEMS=100
